root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
dotnet_sort_system_directives_first = true

[*.{md,json,yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
